{
  "name": "central-campanhas",
  "productName": "Central de Campanhas",
  "version": "0.15.0",
  "description": "Visão completa das campanhas ativas por cliente — Meta, Google e LinkedIn, com criativos e estratégia",
  "main": "electron/main.cjs",
  "author": "@diasesteci",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:macdir": "electron-builder --mac dir",
    "build:mac": "electron-builder --mac dmg zip",
    "build:win": "electron-builder --win nsis --x64",
    "dist": "electron-builder -mw"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.diasesteci.centralcampanhas",
    "productName": "Central de Campanhas",
    "afterPack": "build/afterPack.js",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "electron/**",
      "src/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "identity": null,
      "icon": "build/icon.png",
      "extendInfo": {
        "CFBundleDisplayName": "Central de Campanhas"
      }
    },
    "dmg": {
      "title": "Central de Campanhas"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Central de Campanhas"
    },
    "afterSign": "build/afterSign.js"
  }
}